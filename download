import { useQuestions } from '../hooks/useQuestions';
import TopicCard from '../components/TopicCard';

export default function Topics() {
  const q = useQuestions();
  if (q.status !== 'ready') return null;
  return (
    <div>
      <h1 className="mb-4 text-2xl font-bold sm:text-3xl">Теми</h1>
      <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">{q.data.topics.map((t) => <TopicCard key={t.id} topic={t} detailed />)}</div>
    </div>
  );
}
